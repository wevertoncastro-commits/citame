# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional local API token for the Microsoft Word add-in.
# Generate a random secret and use the same value in the add-in's connection panel.
CITAME_WORD_API_TOKEN=""

# Vercel + Supabase. Leave unset to run Citame with SQLite and local files.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_DATABASE_URL=""
SUPABASE_STORAGE_BUCKET="citame-library"
